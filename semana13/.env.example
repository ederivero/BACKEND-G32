# Cuando usamos Docker y mis servicios se estaran comunicando entre si, los host que normalmente solemos utilizar ahora usaremos el NOMBRE DEL SERVICIO ya que no existe como tal un host sino que todo funciona en el mismo contenedor 
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
# DJANGO
# En el caso de querer conectar nuestro contenedor desde afuera de postgres tendriamos que usar el puerto que estamos exponiendo (5433) pero al estar tanto el proyecto api con la bd en el mismo contenedor el puerto tiene que ser el mismo que maneja internamente (5432)
POSTGRES_PORT=
POSTGRES_HOST=base_de_datos
DEBUG=1
SECRET_KEY=ultramegasecreto

#REDIS
# redis://HOST:PORT/BD
REDIS_URL=redis://redis:6379/0